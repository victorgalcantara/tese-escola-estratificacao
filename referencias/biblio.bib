@article{souza_history_2018,
	title = {A history of inequality: {Top} incomes in {Brazil}, 1926–2015},
	volume = {57},
	issn = {02765624},
	shorttitle = {A history of inequality},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0276562417302068},
	doi = {10.1016/j.rssm.2018.07.003},
	abstract = {This paper uses income tax tabulations to estimate top income shares in Brazil over the long run. Between 1926 and 2015, the concentration of income at the top remained very high, following a sine wave trend: top shares ebbed and ﬂowed over time, frequently in tandem with political and institutional disruptions. There is some evidence in favor of Williamson’s “missed leveling” hypothesis regarding the origins of Latin America’s exceptionally high levels of inequality, but the recent decline in inequality is cast in a more dubious light, since top income shares remained quite stable since 2000 and the "tax-adjusted" Gini coeﬃcients show a smaller and shorter, though still sizeable, decrease. The nature of the political regime matters, but democracy is not a sufﬁcient condition for redistribution. Brazil’s tumultuous political history suggests top income shares change substantially mostly during political-institutional crises, when the typical quid pro quo of more liberal regimes in normal times collapses. I complement the analysis with international comparisons and a discussion of the role of institutions in shaping inequality.},
	language = {en},
	urldate = {2023-07-27},
	journal = {Research in Social Stratification and Mobility},
	author = {Souza, Pedro H.G.F.},
	month = oct,
	year = {2018},
	pages = {35--45},
	file = {Souza - 2018 - A history of inequality Top incomes in Brazil, 19.pdf:G\:\\Meu Drive\\01 biblio\\Zotero\\storage\\B8Z2MAVY\\Souza - 2018 - A history of inequality Top incomes in Brazil, 19.pdf:application/pdf},
}

